# =============================================================================
# Generate IO_FILE from the active segmented IO-pad ring model.
# =============================================================================
if {![info exists ::IOPAD_RING_MODEL_ACTIVE] || !$::IOPAD_RING_MODEL_ACTIVE} {
    error "generate_io_file_ring_model.tcl requires an active IO-pad ring model"
}

proc ring_io_write_inst {fp inst_name {orientation ""} {offset ""}} {
    set fields [list "name=\"$inst_name\""]
    if {$orientation ne ""} { lappend fields "orientation=$orientation" }
    if {$offset ne ""} { lappend fields "offset=$offset" }
    puts $fp "\t(inst [join $fields { }])"
}

proc ring_io_find_inst {local_name} {
    foreach pattern [list $local_name "*/$local_name"] {
        if {![catch {set m [get_db insts $pattern]}] && [llength $m] > 0} { return [lindex $m 0] }
    }
    return ""
}

proc ring_io_side_length {side} {
    lassign [lrange $::FLOORPLAN_BOX_SIZE 0 3] llx lly urx ury
    if {$side eq "top" || $side eq "bottom"} { return [expr {$urx - $llx}] }
    return [expr {$ury - $lly}]
}

proc ring_io_inst_tangent_size {inst_name side} {
    set inst [ring_io_find_inst $inst_name]
    if {$inst eq ""} { error "Cannot calculate IO offset: instance '$inst_name' was not found" }
    set bc [get_db $inst .base_cell]
    if {[info exists ::ENABLE_IO_SWAP] && $::ENABLE_IO_SWAP} {
        set bc_name [get_db $bc .name]
        set target_hv [expr {$side eq "top" || $side eq "bottom" ? "V" : "H"}]
        if {[regexp {^(.*)_[HV]$} $bc_name -> stem]} {
            set target_name "${stem}_${target_hv}"
            set target_bc [get_db base_cells $target_name]
            if {[llength $target_bc] > 0} { set bc [lindex $target_bc 0] }
        }
    }
    set llx [get_db $bc .bbox.ll.x]
    set lly [get_db $bc .bbox.ll.y]
    set urx [get_db $bc .bbox.ur.x]
    set ury [get_db $bc .bbox.ur.y]
    if {$side eq "top" || $side eq "bottom"} { return [expr {$urx - $llx}] }
    return [expr {$ury - $lly}]
}

proc ring_io_write_side_entries {fp side entries} {
    set n [llength $entries]
    if {$n == 0} { return }
    set use_corner_offset [expr {[info exists ::ENABLE_IO_CORNER_OFFSET] && $::ENABLE_IO_CORNER_OFFSET}]
    set edge_len [ring_io_side_length $side]
    for {set i 0} {$i < $n} {incr i} {
        set inst_name [lindex $entries $i]
        set offset ""
        if {$use_corner_offset && $i == 0} {
            set offset [format %.3f $::IO_CORNER_PAD_OFFSET]
        } elseif {$use_corner_offset && $i == ($n - 1)} {
            set tangent [ring_io_inst_tangent_size $inst_name $side]
            set last_offset [expr {$edge_len - $::IO_CORNER_PAD_OFFSET - $tangent}]
            if {$last_offset <= $::IO_CORNER_PAD_OFFSET} {
                error "IO_CORNER_PAD_OFFSET=$::IO_CORNER_PAD_OFFSET is too large for side '$side'"
            }
            set offset [format %.3f $last_offset]
        }
        ring_io_write_inst $fp $inst_name "" $offset
    }
}

proc ring_io_pad_sort {a b} {
    set ai [dict get $a order_index]
    set bi [dict get $b order_index]
    if {$ai < $bi} { return -1 }
    if {$ai > $bi} { return 1 }
    return [string compare [dict get $a instance] [dict get $b instance]]
}

array set side_entries {top {} right {} bottom {} left {}}
set ring $::IOPAD_RING_MODEL
set order [dict get $ring order]
set seen [dict create]

foreach domain_name $order {
    set d [dict get $ring domains $domain_name]
    set side [dict get $d segment side]
    set pads {}
    foreach field {io_power_pads rte_pads ground_pads signal_pads} {
        foreach p [dict get $d $field] { lappend pads $p }
    }
    foreach p [lsort -command ring_io_pad_sort $pads] {
        set inst_name [dict get $p instance]
        if {[dict exists $seen $inst_name]} {
            error "IOPAD ring generator saw duplicate instance '$inst_name'"
        }
        dict set seen $inst_name 1
        lappend side_entries($side) $inst_name
    }

    # Find the cut from this domain to its next domain and place it directly
    # after the domain. This includes the last->first closure cut.
    set next [dict get $d next_domain]
    set cut_found ""
    dict for {cut_name cut} [dict get $ring cuts] {
        if {[dict get $cut left_domain] eq $domain_name &&
            [dict get $cut right_domain] eq $next} {
            set cut_found $cut_name
            break
        }
    }
    if {$cut_found eq ""} {
        error "No boundary cell was found for IO-pad domain boundary '$domain_name' -> '$next'"
    }
    lappend side_entries($side) $cut_found
}

set fp [open $IO_FILE w]
puts $fp "###############################################################"
puts $fp "# Generated by IO-pad ring model"
puts $fp "# Ring: $IOPAD_RING_NAME"
puts $fp "# Common ground: $IOPAD_RING_COMMON_GROUND"
puts $fp "# Domains: [join $order { -> }] -> [lindex $order 0]"
puts $fp "###############################################################"
puts $fp "(globals"
puts $fp "    version = 3"
puts $fp "    io_order = default"
puts $fp ")"
puts $fp "(iopad"
puts $fp "    (topright"
ring_io_write_inst $fp CORNERTR
puts $fp "    )"
puts $fp "    (top"
ring_io_write_side_entries $fp top $side_entries(top)
puts $fp "    )"
puts $fp "    (topleft"
ring_io_write_inst $fp CORNERTL MX
puts $fp "    )"
puts $fp "    (left"
ring_io_write_side_entries $fp left $side_entries(left)
puts $fp "    )"
puts $fp "    (bottomleft"
ring_io_write_inst $fp CORNERBL
puts $fp "    )"
puts $fp "    (bottom"
ring_io_write_side_entries $fp bottom $side_entries(bottom)
puts $fp "    )"
puts $fp "    (bottomright"
ring_io_write_inst $fp CORNERBR MY
puts $fp "    )"
puts $fp "    (right"
ring_io_write_side_entries $fp right $side_entries(right)
puts $fp "    )"
puts $fp ")"
close $fp

puts "INFO: Generated IO file from segmented IO-pad ring model: $IO_FILE"
