# Runtime adapter preserves the historical logical source path.
if {[info exists ::TECH_MV_RUNTIME_ROOT]} {
    info script [file join $::TECH_MV_RUNTIME_ROOT run/tool/01_floorplan/TT_proc_pkg_exchange.tcl]
}
# =============================================================================
# TT_proc_pkg_exchange.tcl
# =============================================================================
# V129 shared package-exchange support for ioPKG.tar / GnetPKG.tar.
#
# Container : uncompressed POSIX tar. Written by ioPADt (Python tarfile
#             stdlib); extracted here with the system `tar` binary via
#             `exec`, which is assumed present on the Linux hosts Innovus
#             runs on (matches every other `exec`-based helper already in
#             this tool chain, e.g. TT_flow_iopad_interface_start.tcl).
# Manifest  : plain-text KEY=VALUE, filename manifest.tt, first line is the
#             magic string TT_PKG_MANIFEST_V1. Deliberately NOT JSON: this
#             Tcl environment has no guaranteed json/tcllib package, and a
#             KEY=VALUE format needs none.
# Checksums : sha256 over the exact payload/patch bytes, verified here with
#             `exec sha256sum` (same tool family as every other SHA256
#             artifact this project already produces, e.g.
#             TT_iopad_restored_global_net_canonical.sha256).
#
# APPLY-ONCE GUARD (the reason this file exists as a shared library):
#   Package payloads generated by ioPADt (the IO DB patch especially) stage
#   renames through unique temporary names and then require the FINAL name
#   to be free (TT_IOPAD_REQUIRE_NO_INST). That is safe to source exactly
#   once, but sourcing the *same* patch a second time in the same Innovus
#   session does not no-op - it errors, because the first application
#   already moved the design into the post-patch state the second
#   application assumes is the pre-patch state. Because a *.tar package is
#   a file a user can hand to redo_IO / read_GnetPKG more than once (retry,
#   copy/paste the same command, re-source a saved session), every patch
#   application coming through this library is gated by a persistent
#   sha256-keyed guard: ::TT_PKG_APPLIED_PATCH_SHA256(<sha256>).
#
#   The same guard array is also written to by the ioPADt-generated Apply
#   DB + IO_FILE / Apply Global Net Tcl (see TT_tool_iopad_gui.py
#   _pkg_guarded_tcl_block), so a patch applied once via the GUI's direct
#   Apply path and later replayed via a package (or vice versa) is still
#   only ever applied once per Innovus session, because both paths key off
#   the identical sha256 of the exact patch text.
# =============================================================================

if {![info exists ::TT_PKG_APPLIED_PATCH_SHA256]} {
    array set ::TT_PKG_APPLIED_PATCH_SHA256 {}
}

# Cheap sniff used only to route the caller to the package-extract branch.
# The authoritative check is always the manifest KIND read in
# tt_pkg_extract; this only decides which branch to try.
proc tt_pkg_is_package {path} {
    return [expr {[string match "*.tar" $path] && [file isfile $path]}]
}

proc tt_pkg_sha256_file {path} {
    if {![file isfile $path]} {
        error "tt_pkg_sha256_file: file does not exist: $path"
    }
    if {[catch {exec sha256sum $path} out]} {
        error "tt_pkg_sha256_file: sha256sum failed for $path: $out"
    }
    return [lindex $out 0]
}

# Parse a manifest.tt file into a dict. Errors if the magic line is missing
# or wrong - this is the FIRST thing checked so an unrelated *.tar never
# gets partially trusted.
proc tt_pkg_read_manifest {manifest_path} {
    if {![file isfile $manifest_path]} {
        error "tt_pkg_read_manifest: manifest.tt not found: $manifest_path"
    }
    set fh [open $manifest_path r]
    set text [read $fh]
    close $fh

    set lines [split $text \n]
    if {[llength $lines] == 0 || [string trim [lindex $lines 0]] ne "TT_PKG_MANIFEST_V1"} {
        error "tt_pkg_read_manifest: bad/unsupported manifest magic in $manifest_path"
    }

    set kv [dict create]
    foreach line [lrange $lines 1 end] {
        if {[string trim $line] eq ""} { continue }
        set idx [string first "=" $line]
        if {$idx < 0} { continue }
        set key [string range $line 0 [expr {$idx - 1}]]
        set value [string range $line [expr {$idx + 1}] end]
        dict set kv $key $value
    }
    return $kv
}

# Extract pkg_path (must be a *.tar produced by ioPADt) into a fresh work
# directory under ioPADt/build/pkg_extract/, verify KIND + both checksums,
# and return a dict: payload_path patch_path manifest work_dir
#
# expected_kind must be exactly "IO_PKG" or "GNET_PKG".
proc tt_pkg_extract {pkg_path expected_kind} {
    set pkg_path [file normalize $pkg_path]
    if {![file isfile $pkg_path]} {
        error "tt_pkg_extract: package does not exist: $pkg_path"
    }

    if {![info exists ::TOOL_DIR] || $::TOOL_DIR eq ""} {
        error "tt_pkg_extract: TOOL_DIR is unavailable; cannot resolve ioPADt/build/pkg_extract."
    }
    set extract_root [file join $::TOOL_DIR ioPADt build pkg_extract]
    file mkdir $extract_root

    set stamp [clock format [clock seconds] -format "%Y%m%d_%H%M%S"]
    set work_dir [file join $extract_root "${stamp}_[clock clicks]_[file tail $pkg_path]"]
    file mkdir $work_dir

    if {[catch {exec tar -xf $pkg_path -C $work_dir} err]} {
        error "tt_pkg_extract: failed to extract $pkg_path into $work_dir: $err"
    }

    set kv [tt_pkg_read_manifest [file join $work_dir manifest.tt]]

    if {![dict exists $kv KIND] || [dict get $kv KIND] ne $expected_kind} {
        set got ""
        catch {set got [dict get $kv KIND]}
        error "tt_pkg_extract: $pkg_path KIND mismatch: expected $expected_kind, got \"$got\""
    }

    foreach {file_key sha_key} {
        PAYLOAD_FILE PAYLOAD_SHA256
        PATCH_FILE   PATCH_SHA256
    } {
        if {![dict exists $kv $file_key] || ![dict exists $kv $sha_key]} {
            error "tt_pkg_extract: $pkg_path manifest missing $file_key/$sha_key"
        }
    }

    set payload_path [file join $work_dir [dict get $kv PAYLOAD_FILE]]
    set patch_path   [file join $work_dir [dict get $kv PATCH_FILE]]

    if {![file isfile $payload_path]} {
        error "tt_pkg_extract: $pkg_path missing declared payload [dict get $kv PAYLOAD_FILE]"
    }
    if {![file isfile $patch_path]} {
        error "tt_pkg_extract: $pkg_path missing declared patch [dict get $kv PATCH_FILE]"
    }

    set actual_payload_sha [tt_pkg_sha256_file $payload_path]
    if {$actual_payload_sha ne [dict get $kv PAYLOAD_SHA256]} {
        error "tt_pkg_extract: $pkg_path payload checksum mismatch: expected [dict get $kv PAYLOAD_SHA256] got $actual_payload_sha"
    }
    set actual_patch_sha [tt_pkg_sha256_file $patch_path]
    if {$actual_patch_sha ne [dict get $kv PATCH_SHA256]} {
        error "tt_pkg_extract: $pkg_path patch checksum mismatch: expected [dict get $kv PATCH_SHA256] got $actual_patch_sha"
    }

    puts "INFO: tt_pkg_extract PASS pkg=$pkg_path kind=$expected_kind payload_sha256=$actual_payload_sha patch_sha256=$actual_patch_sha work_dir=$work_dir"

    return [dict create \
        payload_path $payload_path \
        patch_path   $patch_path \
        payload_sha256 $actual_payload_sha \
        patch_sha256   $actual_patch_sha \
        manifest $kv \
        work_dir $work_dir]
}

# Source $script_path AT MOST ONCE per Innovus session, keyed by the sha256
# of its exact current file content. $label is only used in log messages.
# Returns 1 if it actually sourced (first time), 0 if it was skipped
# (already applied earlier in this session).
proc tt_pkg_source_once {script_path label} {
    set sha [tt_pkg_sha256_file $script_path]
    if {[info exists ::TT_PKG_APPLIED_PATCH_SHA256($sha)]} {
        puts "INFO: $label sha256=$sha already applied in this Innovus session; skipping re-apply ($script_path)."
        return 0
    }
    puts "INFO: $label sha256=$sha applying ($script_path)."
    uplevel #0 [list source -quiet $script_path]
    set ::TT_PKG_APPLIED_PATCH_SHA256($sha) 1
    puts "INFO: $label sha256=$sha applied and recorded."
    return 1
}
