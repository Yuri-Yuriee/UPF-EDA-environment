# PUBLIC_EXPORT_REVIEW_REQUIRED: residual technology candidates require manual review.
# =============================================================================
# TT_proc_bond_pad_preview.tcl
# =============================================================================
# Reusable FILL_IN_CELL_BOND_PAD_041 preview/checkpoint engine.
#
# Stage-01 special feature:
#   While suspended at the final pre-IO-filler FILL_IN_CELL_BOND_PAD_041 preview, the user may run:
#
#       redo_IO
#       redo_IO /path/to/new.io
#       redo_IO /path/to/new.ioPKG.tar
#
#   redo_IO does NOT leave the current native Innovus suspend call stack.  It:
#     1. deletes temporary FILL_IN_CELL_BOND_PAD_041 preview objects;
#     2. returns ALL design instances to UNPLACED;
#     3. optionally changes the runtime IO_FILE path (accepts either a plain
#        *.io file, or an *.ioPKG.tar package bundling that IO_FILE together
#        with its DB patch - see TT_proc_pkg_exchange.tcl);
#     3b. if given an *.ioPKG.tar, applies the bundled DB patch BEFORE the
#        floorplan/IO reload below, exactly like the GUI's own
#        Apply DB + IO_FILE ordering (DB patch first, IO reload second).
#        The patch is applied AT MOST ONCE per Innovus session (keyed by its
#        content sha256, via tt_pkg_source_once) because it stages renames
#        through temporary names and is NOT safe to replay verbatim - see
#        TT_proc_pkg_exchange.tcl header for why.
#     4. re-runs the Floorplan Bound selector on that IO_FILE and recreates
#        the IO-bound/core-cell-bound floorplan as required;
#     5. re-runs the Stage-01 IO placement/snap/HV-swap sub-flow;
#     6. recreates the FILL_IN_CELL_BOND_PAD_041 preview and overwrites the preview DB;
#     7. returns to the SAME [SUSPEND] Innovus prompt.
#
#   The normal native command "resume" means ACCEPT THE CURRENT IN-MEMORY DB
#   STATE and continue the unfinished Stage-01 Tcl flow from the suspend point.
#   Native resume NEVER re-reads IO_FILE, never unplaces instances, never
#   re-runs the Floorplan Bound selector, and never recreates the floorplan.
#   Any IO_FILE/floorplan rework must be requested explicitly with redo_IO.
# =============================================================================

# Package-exchange support (*.ioPKG.tar). Source defensively: this file may
# be sourced stand-alone (e.g. from Innovus's FILL_IN_CELL_BOND_PAD_041 preview checkpoint)
# before TT_flow_iopad_interface_start.tcl has run in this session.
if {[llength [info commands tt_pkg_is_package]] == 0} {
    if {![info exists ::TOOL_DIR] || $::TOOL_DIR eq ""} {
        error "TT_proc_bond_pad_preview.tcl requires TOOL_DIR to locate TT_proc_pkg_exchange.tcl."
    }
    uplevel #0 [list source -quiet [file join $::TOOL_DIR 01_floorplan TT_proc_pkg_exchange.tcl]]
}

proc tt_bond_pad_set_parity {right top left bottom} {
    set ::libvar::rightpad_down $right
    set ::libvar::toppad_right $top
    set ::libvar::leftpad_up $left
    set ::libvar::bottompad_left $bottom
}

proc tt_bond_pad_current_parity {} {
    return [list \
        $::libvar::rightpad_down \
        $::libvar::toppad_right \
        $::libvar::leftpad_up \
        $::libvar::bottompad_left]
}

proc tt_bond_pad_write_parity {combo} {
    lassign $combo right top left bottom
    set fp [open $::BOND_PAD_PARITY_FILE w]
    puts $fp "# Generated by zero-overlap FILL_IN_CELL_BOND_PAD_041 preview."
    puts $fp "set BOND_PAD_RIGHT_DOWN $right"
    puts $fp "set BOND_PAD_TOP_RIGHT $top"
    puts $fp "set BOND_PAD_LEFT_UP $left"
    puts $fp "set BOND_PAD_BOTTOM_LEFT $bottom"
    close $fp
    puts "INFO: Saved zero-overlap bond-pad parity: $::BOND_PAD_PARITY_FILE"
}

proc tt_bond_pad_load_saved_parity {} {
    if {![file isfile $::BOND_PAD_PARITY_FILE]} { return false }
    uplevel #0 [list source $::BOND_PAD_PARITY_FILE]
    tt_bond_pad_set_parity \
        $::BOND_PAD_RIGHT_DOWN \
        $::BOND_PAD_TOP_RIGHT \
        $::BOND_PAD_LEFT_UP \
        $::BOND_PAD_BOTTOM_LEFT
    puts "INFO: Loaded saved FILL_IN_CELL_BOND_PAD_041 parity: [tt_bond_pad_current_parity]"
    return true
}

proc tt_bond_pad_candidate_combos {} {
    set result {}
    set current [tt_bond_pad_current_parity]
    lappend result $current
    foreach r {outer inner} {
        foreach t {outer inner} {
            foreach l {outer inner} {
                foreach b {outer inner} {
                    set c [list $r $t $l $b]
                    if {[lsearch -exact $result $c] < 0} { lappend result $c }
                }
            }
        }
    }
    return $result
}

proc tt_bond_pad_run_preview_combo {combo} {
    lassign $combo right top left bottom
    tt_bond_pad_set_parity $right $top $left $bottom
    set ::BOND_PAD_PREVIEW_ONLY true
    create_bond_pad_and_route
    unset ::BOND_PAD_PREVIEW_ONLY
    return [llength $::libvar::overlap_bond_pads]
}

proc tt_bond_pad_select_preview {search_parity} {
    set best_combo ""
    set best_count 1000000
    set selected_combo ""
    set selected_count 1000000

    if {$search_parity} {
        foreach combo [tt_bond_pad_candidate_combos] {
            set count [tt_bond_pad_run_preview_combo $combo]
            puts "INFO: FILL_IN_CELL_BOND_PAD_041 parity $combo -> overlap_count=$count"
            if {$count < $best_count} {
                set best_count $count
                set best_combo $combo
            }
            if {$count == 0} {
                set selected_combo $combo
                set selected_count 0
                break
            }
        }
        if {$selected_combo eq ""} {
            set selected_combo $best_combo
            set selected_count [tt_bond_pad_run_preview_combo $selected_combo]
        }
    } else {
        if {![tt_bond_pad_load_saved_parity]} {
            puts "WARNING: No saved parity file. Using current configured parity."
        }
        set selected_combo [tt_bond_pad_current_parity]
        set selected_count [tt_bond_pad_run_preview_combo $selected_combo]
    }

    set ::TECH_BOND_PAD_PREVIEW_PARITY $selected_combo
    set ::TECH_BOND_PAD_PREVIEW_OVERLAPS $selected_count

    if {$selected_count == 0} {
        tt_bond_pad_write_parity $selected_combo
    } elseif {$search_parity} {
        catch { file delete -force $::BOND_PAD_PARITY_FILE }
    }

    return [dict create combo $selected_combo count $selected_count]
}

proc tt_bond_pad_save_preview_db {preview_db_name} {
    if {!$::BOND_PAD_PREVIEW_SAVE_DB || $preview_db_name eq ""} {
        return ""
    }

    set db [file join $::DB_DIR $preview_db_name]
    write_db $db
    puts "INFO: FILL_IN_CELL_BOND_PAD_041 GUI preview DB = $db"
    return $db
}

proc tt_bond_pad_print_manual_global_net_reminder {} {
    puts "#"
    puts "# MANUAL GLOBAL NET CHECK IS REQUIRED AT THIS CHECKPOINT."
    puts "# Verify expected POWER/GROUND global nets and intended PAD/PG-pin connectivity."
    puts {# Suggested Stylus checks:}
    puts {#   get_db nets -if {.is_power == true} .name}
    puts {#   get_db nets -if {.is_ground == true} .name}
}

proc tt_bond_pad_print_action_prompt {label selected_combo selected_count reload_io_on_resume} {
    puts ""
    puts "######################################################################"
    puts "# ACTION REQUIRED: FILL_IN_CELL_BOND_PAD_041 PREVIEW - $label"
    puts "######################################################################"
    puts "# Selected parity : $selected_combo"
    puts "# Overlap count   : $selected_count"
    puts [::tech_mv_library_value LIB_TEXT_006]
    puts [::tech_mv_library_value LIB_TEXT_007]

    if {$reload_io_on_resume} {
        puts "# IO fillers have NOT been inserted and IO pads are NOT fixed yet."
        puts "# Current IO_FILE : $::IO_FILE"
        puts "#"
        puts "# To rebuild the IO placement while STAYING at this same suspend point:"
        puts "#   redo_IO"
        puts "#   redo_IO /absolute/or/relative/path/to/new.io"
        puts "#   redo_IO /absolute/or/relative/path/to/new.ioPKG.tar"
        puts "#"
        puts [::tech_mv_library_value LIB_TEXT_008]
        puts "# Floorplan Bound selector/create step for the current IO_FILE, then the"
        puts [::tech_mv_library_value LIB_TEXT_009]
        puts {# overwrites the preview DB, then returns to this SAME [SUSPEND] prompt.}
        puts "# If a path is supplied, that path becomes the runtime IO_FILE."
        puts "# If an *.ioPKG.tar is supplied, its bundled DB patch is applied FIRST"
        puts "# (once per session) and its payload becomes the runtime IO_FILE."
        puts "#"
        puts "# You may edit $::IO_FILE manually while suspended, but native resume"
        puts "# DOES NOT read that file. To apply any IO_FILE edit, run redo_IO first."
        puts "# Native resume accepts the CURRENT in-memory IO/PAD placement as-is."
    }

    if {[llength [info commands ::TT_IOPAD_GUI_START]]} {
        puts "#"
        puts "# To open ioPADt while staying at this checkpoint:"
        puts "#   TT_IOPAD_GUI_START"
        puts "# GUI changes still require the existing apply / redo_IO workflow."
    }

    tt_bond_pad_print_manual_global_net_reminder

    puts "#"
    puts "# When ready to ACCEPT this preview and continue the unfinished script:"
    puts "#   resume"
    puts "######################################################################"
    flush stdout
}

proc tt_bond_pad_activate_redo_context {label preview_db_name search_parity reload_io_on_resume} {
    set ::TECH_BOND_PAD_PREVIEW_ACTIVE true
    set ::TECH_BOND_PAD_PREVIEW_LABEL $label
    set ::TECH_BOND_PAD_PREVIEW_DB_NAME_ACTIVE $preview_db_name
    set ::TECH_BOND_PAD_PREVIEW_SEARCH_PARITY_ACTIVE $search_parity
    set ::TECH_BOND_PAD_PREVIEW_RELOAD_IO_ACTIVE $reload_io_on_resume
    if {![info exists ::TECH_BOND_PAD_REDO_COUNT]} {
        set ::TECH_BOND_PAD_REDO_COUNT 0
    }
}

proc tt_bond_pad_deactivate_redo_context {} {
    foreach v {
        TECH_BOND_PAD_PREVIEW_ACTIVE
        TECH_BOND_PAD_PREVIEW_LABEL
        TECH_BOND_PAD_PREVIEW_DB_NAME_ACTIVE
        TECH_BOND_PAD_PREVIEW_SEARCH_PARITY_ACTIVE
        TECH_BOND_PAD_PREVIEW_RELOAD_IO_ACTIVE
    } {
        catch {unset ::$v}
    }
}

proc tt_bond_pad_redo_unplace_all_instances {} {
    set insts [get_db insts]
    set total [llength $insts]

    if {$total == 0} {
        puts "INFO: redo_IO found no instances to unplace."
        return 0
    }

    puts "INFO: redo_IO returning ALL $total instance(s) to UNPLACED."
    set_db $insts .place_status unplaced

    set residual {}
    foreach inst $insts {
        set status ""
        catch {set status [get_db $inst .place_status]}
        if {$status ne "unplaced"} {
            lappend residual $inst
        }
    }

    if {[llength $residual] > 0} {
        puts "ERROR: redo_IO could not unplace [llength $residual] instance(s)."
        set shown 0
        foreach inst $residual {
            if {$shown >= 30} { break }
            set n ""
            set c ""
            set s ""
            catch {set n [get_db $inst .name]}
            catch {set c [get_db $inst .base_cell.name]}
            catch {set s [get_db $inst .place_status]}
            puts "ERROR:   $n cell=$c status=$s"
            incr shown
        }
        error "redo_IO requires all instances to be UNPLACED before re-reading IO_FILE."
    }

    puts "PASS: redo_IO confirmed all $total instance(s) are UNPLACED."
    return $total
}

proc tt_bond_pad_recreate_floorplan_bound {} {
    if {[llength [info commands TT_floorplan_bound_create]] == 0} {
        if {![info exists ::TOOL_DIR] || $::TOOL_DIR eq ""} {
            error "redo_IO cannot load Floorplan Bound selector because TOOL_DIR is unavailable."
        }
        set selector [file join $::TOOL_DIR 01_floorplan geometry TT_proc_floorplan_bound_selector.tcl]
        if {![file isfile $selector]} {
            error "redo_IO Floorplan Bound selector does not exist: $selector"
        }
        uplevel #0 [list source -quiet $selector]
    }

    puts ""
    puts "######################################################################"
    puts "# REDO IO: RE-EVALUATE FLOORPLAN BOUND MODE"
    puts "######################################################################"
    puts "# IO_FILE : $::IO_FILE"
    puts "# The selector will recompute IO minimum W/H, core-cell area ratio,"
    puts "# selected IO_BOUND/CORE_CELL_BOUND mode, and recreate the floorplan."
    puts "######################################################################"

    set r [TT_floorplan_bound_create $::IO_FILE]
    set ::TECH_MV_FLOORPLAN_BOUND_RESULT $r

    set mode ""
    if {[dict exists $r selected_mode]} {
        set mode [dict get $r selected_mode]
    } elseif {[dict exists $r mode]} {
        set mode [dict get $r mode]
    }
    set ratio ""
    if {[dict exists $r ratio]} { set ratio [dict get $r ratio] }

    puts "INFO: redo_IO Floorplan Bound selected_mode=$mode ratio=$ratio"
    if {$mode eq "IO_BOUND" &&
        [dict exists $r io_min_die_w] && [dict exists $r io_min_die_h]} {
        puts [format "INFO: redo_IO IO-bound suggested DIE = %.3f x %.3f" \
            [dict get $r io_min_die_w] [dict get $r io_min_die_h]]
    }

    return $r
}

proc tt_bond_pad_reload_stage01_io {} {
    if {[llength [info commands fp_run_io_placement_phase]] > 0} {
        return [fp_run_io_placement_phase $::IO_FILE]
    }

    # Fallback for direct tool use outside the normal floorplan helper context.
    puts "WARNING: fp_run_io_placement_phase is unavailable; using local IO reload fallback."
    read_io_file $::IO_FILE -no_die_size_adjust
    snap_floorplan -all
    if {$::ENABLE_IO_SWAP} {
        uplevel #0 [list source -quiet [file join $::SCRIPT_DIR swap_io_hv.tcl]]
        do_swap_io
    }
    snap_floorplan -all
    return $::IO_FILE
}

# User-facing command available while Stage-01 FILL_IN_CELL_BOND_PAD_041 preview is suspended.
proc redo_IO {args} {
    if {![info exists ::TECH_BOND_PAD_PREVIEW_ACTIVE] ||
        !$::TECH_BOND_PAD_PREVIEW_ACTIVE} {
        error "redo_IO is valid only while the FILL_IN_CELL_BOND_PAD_041 preview checkpoint is suspended."
    }

    if {![info exists ::TECH_BOND_PAD_PREVIEW_RELOAD_IO_ACTIVE] ||
        !$::TECH_BOND_PAD_PREVIEW_RELOAD_IO_ACTIVE} {
        error "redo_IO is enabled only for the Stage-01 final pre-IO-filler FILL_IN_CELL_BOND_PAD_041 preview."
    }

    if {[llength $args] > 1} {
        error "Usage: redo_IO ?new_IO_FILE_or_ioPKG.tar?"
    }

    # V129: when the argument is an *.ioPKG.tar package, this is populated
    # with the path to its bundled db_patch.tcl (already extracted +
    # checksum-verified by tt_pkg_extract). It is sourced further below,
    # BEFORE the floorplan/IO reload, and AT MOST ONCE per session.
    set tt_redo_io_bundled_patch ""

    if {[llength $args] == 1} {
        set requested [lindex $args 0]
        set requested_norm [file normalize $requested]
        if {![file exists $requested_norm]} {
            error "redo_IO input does not exist: $requested_norm"
        }

        if {[tt_pkg_is_package $requested_norm]} {
            set pkg [tt_pkg_extract $requested_norm "IO_PKG"]
            set new_io [dict get $pkg payload_path]
            set tt_redo_io_bundled_patch [dict get $pkg patch_path]
            puts "INFO: redo_IO received ioPKG.tar: $requested_norm"
            puts "INFO: redo_IO package payload (IO_FILE) = $new_io"
            puts "INFO: redo_IO package patch (DB patch)  = $tt_redo_io_bundled_patch"
        } else {
            set new_io $requested_norm
            if {![file isfile $new_io]} {
                error "redo_IO new IO file does not exist: $new_io"
            }
        }
        set ::IO_FILE $new_io
        puts "INFO: redo_IO runtime IO_FILE changed to: $::IO_FILE"
    } else {
        if {![file isfile [file normalize $::IO_FILE]]} {
            error "redo_IO current IO_FILE does not exist: $::IO_FILE"
        }
        set ::IO_FILE [file normalize $::IO_FILE]
        puts "INFO: redo_IO reusing current IO_FILE: $::IO_FILE"
    }

    if {[llength [info commands delete_bond_pad_and_route]] == 0} {
        uplevel #0 [list source -quiet [file join $::SCRIPT_DIR create_bond_pad_stylus.tcl]]
    }

    puts ""
    puts "======================================================================"
    puts [::tech_mv_library_value LIB_TEXT_010]
    puts "======================================================================"
    puts "IO_FILE : $::IO_FILE"
    if {$tt_redo_io_bundled_patch ne ""} {
        puts [::tech_mv_library_value LIB_TEXT_011]
    } else {
        puts [::tech_mv_library_value LIB_TEXT_012]
    }
    puts "======================================================================"

    # DB patch MUST run before the floorplan/IO reload below: it is the same
    # ordering the GUI's own Apply DB + IO_FILE uses (DB patch first,
    # redo_IO / IO reload second), so an ioPKG.tar behaves identically to
    # that two-step flow collapsed into one file. tt_pkg_source_once is the
    # apply-once guard: replaying the SAME package a second time in this
    # session (e.g. re-running this exact redo_IO call) skips the patch
    # instead of erroring on its non-idempotent rename staging.
    if {$tt_redo_io_bundled_patch ne ""} {
        tt_pkg_source_once $tt_redo_io_bundled_patch "ioPKG bundled DB patch"
    }

    # Preview FILL_IN_CELL_BOND_PAD_041 objects are not final assignments; preview-only deletion is
    # intentional and does not run noisy per-pad unassign_bumps.
    delete_bond_pad_and_route true

    tt_bond_pad_redo_unplace_all_instances

    # The IO_FILE may have changed PAD count/order/offset/master dimensions.
    # Recompute the bound classification BEFORE read_io_file so redo_IO follows
    # exactly the same floorplan sizing policy as a fresh Stage-01 run.
    set bound_result [tt_bond_pad_recreate_floorplan_bound]

    tt_bond_pad_reload_stage01_io

    set result [tt_bond_pad_select_preview $::TECH_BOND_PAD_PREVIEW_SEARCH_PARITY_ACTIVE]
    set combo [dict get $result combo]
    set count [dict get $result count]

    tt_bond_pad_save_preview_db $::TECH_BOND_PAD_PREVIEW_DB_NAME_ACTIVE

    incr ::TECH_BOND_PAD_REDO_COUNT
    set bound_mode ""
    if {[dict exists $bound_result selected_mode]} {
        set bound_mode [dict get $bound_result selected_mode]
    } elseif {[dict exists $bound_result mode]} {
        set bound_mode [dict get $bound_result mode]
    }
    set bound_ratio ""
    if {[dict exists $bound_result ratio]} { set bound_ratio [dict get $bound_result ratio] }

    puts "INFO: redo_IO completed successfully. redo_count=$::TECH_BOND_PAD_REDO_COUNT"
    puts "INFO: redo_IO Floorplan Bound mode=$bound_mode ratio=$bound_ratio"
    puts [::tech_mv_library_value LIB_TEXT_013]

    tt_bond_pad_print_action_prompt \
        $::TECH_BOND_PAD_PREVIEW_LABEL \
        $combo \
        $count \
        true

    set ret [dict create \
        io_file $::IO_FILE \
        parity $combo \
        overlap_count $count \
        redo_count $::TECH_BOND_PAD_REDO_COUNT \
        floorplan_bound_mode $bound_mode \
        floorplan_bound_ratio $bound_ratio]
    if {[dict exists $bound_result io_min_die_w]} {
        dict set ret io_min_die_w [dict get $bound_result io_min_die_w]
    }
    if {[dict exists $bound_result io_min_die_h]} {
        dict set ret io_min_die_h [dict get $bound_result io_min_die_h]
    }
    return $ret
}

proc tt_bond_pad_finish_after_resume {label after_db_name search_parity reload_io_on_resume selected_combo} {
    puts "INFO: Resumed from FILL_IN_CELL_BOND_PAD_041 preview '$label'. Rechecking accepted IO/FILL_IN_CELL_BOND_PAD_041 state."

    delete_bond_pad_and_route true

    if {$reload_io_on_resume} {
        # IMPORTANT SEMANTICS:
        # This flag only means redo_IO is available at this Stage-01 checkpoint.
        # Native Innovus resume MUST NOT perform any IO/floorplan rework.
        puts "INFO: Stage-01 native resume accepts the CURRENT in-memory IO/PAD state."
        puts "INFO: Native resume does NOT read IO_FILE, unplace instances, recreate floorplan, or rerun Floorplan Bound."
        puts "INFO: IO_FILE edits are applied only when redo_IO is explicitly executed before resume."
    }

    # redo_IO may have changed the selected parity while the original suspend
    # call stack remained active.  Prefer the live global checkpoint parity.
    if {[info exists ::TECH_BOND_PAD_PREVIEW_PARITY] &&
        $::TECH_BOND_PAD_PREVIEW_PARITY ne ""} {
        set selected_combo $::TECH_BOND_PAD_PREVIEW_PARITY
    }

    set selected_count [tt_bond_pad_run_preview_combo $selected_combo]
    set ::TECH_BOND_PAD_PREVIEW_OVERLAPS $selected_count

    if {$selected_count != 0 && $::BOND_PAD_PREVIEW_STRICT_OVERLAP} {
        error "FILL_IN_CELL_BOND_PAD_041 preview '$label' still has $selected_count overlap(s). Adjust IO placement/parity and rerun."
    }

    if {$selected_count == 0} {
        tt_bond_pad_write_parity $selected_combo
        puts "PASS: FILL_IN_CELL_BOND_PAD_041 preview '$label' has zero overlap."
    }

    # Continue implementation with no temporary FILL_IN_CELL_BOND_PAD_041 objects.
    delete_bond_pad_and_route true

    if {$after_db_name ne ""} {
        set adb [file join $::DB_DIR $after_db_name]
        write_db $adb
        puts "INFO: FILL_IN_CELL_BOND_PAD_041 accepted/clean checkpoint DB = $adb"
    }

    return $selected_count
}

proc TT_bond_pad_preview_checkpoint {label preview_db_name after_db_name search_parity {reload_io_on_resume false}} {
    if {[llength [info commands create_bond_pad_and_route]] == 0} {
        uplevel #0 [list source -quiet [file join $::SCRIPT_DIR create_bond_pad_stylus.tcl]]
    }

    puts ""
    puts "======================================================================"
    puts " FILL_IN_CELL_BOND_PAD_041 PREVIEW: $label"
    puts "======================================================================"

    set result [tt_bond_pad_select_preview $search_parity]
    set selected_combo [dict get $result combo]
    set selected_count [dict get $result count]

    tt_bond_pad_save_preview_db $preview_db_name
    tt_bond_pad_activate_redo_context $label $preview_db_name $search_parity $reload_io_on_resume
    tt_bond_pad_print_action_prompt $label $selected_combo $selected_count $reload_io_on_resume

    if {[llength [info commands tech_mv_checkpoint_tools]]} { tech_mv_checkpoint_tools {01_floorplan} {TT_proc_bond_pad_preview} }
    suspend

    set selected_combo $::TECH_BOND_PAD_PREVIEW_PARITY
    set selected_count [tt_bond_pad_finish_after_resume \
        $label \
        $after_db_name \
        $search_parity \
        $reload_io_on_resume \
        $selected_combo]

    tt_bond_pad_deactivate_redo_context
    return $selected_count
}

# Restore helper for the pre-suspend FILL_IN_CELL_BOND_PAD_041 DB.  It rebuilds a NEW native suspend
# call stack so the user can type native "resume" exactly as in the original run.
proc TT_bond_pad_restore_preview_suspend {label preview_db_name after_db_name search_parity {reload_io_on_resume true}} {
    if {[llength [info commands create_bond_pad_and_route]] == 0} {
        uplevel #0 [list source -quiet [file join $::SCRIPT_DIR create_bond_pad_stylus.tcl]]
    }

    if {![tt_bond_pad_load_saved_parity]} {
        puts [::tech_mv_library_value LIB_TEXT_014]
    }

    set selected_combo [tt_bond_pad_current_parity]
    set selected_count "RESTORED"
    set ::TECH_BOND_PAD_PREVIEW_PARITY $selected_combo
    set ::TECH_BOND_PAD_PREVIEW_OVERLAPS -1

    tt_bond_pad_activate_redo_context $label $preview_db_name $search_parity $reload_io_on_resume
    tt_bond_pad_print_action_prompt $label $selected_combo $selected_count $reload_io_on_resume

    if {[llength [info commands tech_mv_checkpoint_tools]]} { tech_mv_checkpoint_tools {01_floorplan} {TT_proc_bond_pad_preview} }
    suspend

    set selected_combo $::TECH_BOND_PAD_PREVIEW_PARITY
    set selected_count [tt_bond_pad_finish_after_resume \
        $label \
        $after_db_name \
        $search_parity \
        $reload_io_on_resume \
        $selected_combo]

    tt_bond_pad_deactivate_redo_context
    return $selected_count
}

# Compatibility wrapper retained for older V17 invocation.
proc TT_bond_pad_floorplan_preview {} {
    return [TT_bond_pad_preview_checkpoint \
        "IO PAD placement" \
        $::IO_BOND_PAD_PREVIEW_DB_NAME \
        $::IO_BOND_PAD_PREVIEW_AFTER_DB_NAME \
        $::BOND_PAD_PREVIEW_SEARCH_PARITY]
}
