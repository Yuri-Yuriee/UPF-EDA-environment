#!/usr/bin/tclsh

# Path tokens are data expanded from the existing C-shell Verify config.
proc verify_expand_resource_paths {text} {
    foreach key [array names ::env VERIFY_RESOURCE_PATH_*] {
        set text [string map [list "@$key@" $::env($key)] $text]
    }
    if {[regexp {@VERIFY_RESOURCE_PATH_[0-9]+@} $text]} {
        error "Verify resource path is not configured; source verify/config.csh first."
    }
    return $text
}

set script_dir [file dirname [file normalize [info script]]]
set lvs_dir    [file normalize [file join $script_dir ..]]
if {![info exists ::env(VERIFY_SOURCE_SPICE_SPEC)] || ![file isfile $::env(VERIFY_SOURCE_SPICE_SPEC)]} {error "Required Verify config file is missing: VERIFY_SOURCE_SPICE_SPEC"}
set spec_file $::env(VERIFY_SOURCE_SPICE_SPEC)
set out_file   [file join $lvs_dir CHIP_inc.spi]
set rpt_dir    [file join $lvs_dir rpt]
set rpt_file   [file join $rpt_dir source_include_generation.rpt]
file mkdir $rpt_dir

proc recursive_source_files {root token} {
    set result {}
    if {![file isdirectory $root]} {
        return $result
    }
    foreach p [glob -nocomplain -directory $root *] {
        if {[file isdirectory $p]} {
            foreach q [recursive_source_files $p $token] {
                lappend result $q
            }
        } else {
            set ext [string tolower [file extension $p]]
            if {$ext ni {.spi .sp .cdl}} {
                continue
            }
            if {[string first $token [file tail $p]] >= 0} {
                lappend result [file normalize $p]
            }
        }
    }
    return $result
}

set sf [open $spec_file r]
set files {}
set errors {}

while {[gets $sf line] >= 0} {
    set line [string trim [verify_expand_resource_paths $line]]
    if {$line eq "" || [string match "#*" $line]} {
        continue
    }

    set fields [regexp -inline -all {\S+} $line]
    set type [lindex $fields 0]

    switch -- $type {
        REQUIRED {
            set path [lindex $fields 1]
            if {![file exists $path]} {
                lappend errors "Missing REQUIRED source: $path"
            } else {
                lappend files [file normalize $path]
            }
        }
        GLOB_REQUIRED {
            set pattern [lindex $fields 1]
            set matches [glob -nocomplain $pattern]
            if {[llength $matches] == 0} {
                lappend errors "No match for GLOB_REQUIRED: $pattern"
            } else {
                foreach p $matches {
                    lappend files [file normalize $p]
                }
            }
        }
        SEARCH_REQUIRED {
            set root  [lindex $fields 1]
            set token [lindex $fields 2]
            set matches [recursive_source_files $root $token]
            if {[llength $matches] == 0} {
                lappend errors "No SPICE/CDL source containing '$token' below: $root"
            } else {
                # Prefer the shortest matching path: typically the library-level
                # SPICE file rather than a nested example/test copy.
                set pairs {}
                foreach p $matches {
                    lappend pairs [list [string length $p] $p]
                }
                set pairs [lsort -integer -index 0 $pairs]
                lappend files [lindex [lindex $pairs 0] 1]
            }
        }
        default {
            lappend errors "Unknown source spec type '$type': $line"
        }
    }
}
close $sf

if {[info exists ::env(TECH_LVS_SOURCE_ADDED)]} {
    set source_added $::env(TECH_LVS_SOURCE_ADDED)
    if {[file exists $source_added]} {
        lappend files [file normalize $source_added]
    } else {
        lappend errors "Missing TECH PDK source.added: $source_added"
    }
} else {
    lappend errors "TECH_LVS_SOURCE_ADDED is not defined"
}

if {[llength $errors] > 0} {
    puts stderr "ERROR: Cannot generate CHIP_inc.spi"
    foreach e $errors { puts stderr "  $e" }
    exit 1
}

set files [lsort -unique $files]

set of [open $out_file w]
puts $of "* Auto-generated by TECH_MV verify/lvs/scr/genSourceInc.tcl"
puts $of "* Do not hand-edit; edit source_spice.spec instead."
foreach p $files {
    puts $of ".INCLUDE $p"
}
puts $of ".INCLUDE CHIP.spi"
close $of

set rf [open $rpt_file w]
puts $rf "TECH_MV Source Include Generation"
puts $rf "================================"
puts $rf "External source files: [llength $files]"
foreach p $files { puts $rf "  $p" }
puts $rf "  CHIP.spi"
close $rf

puts "Generated $out_file"
puts "External source files = [llength $files]"
